# BTC-Quant Environment
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Local development: http://127.0.0.1:7890
# Docker Desktop:   http://host.docker.internal:7890
OKX_PROXY=
MARKET_DATA_PROVIDER=okx
COLLECTOR_INTERVAL_SEC=15

# Database
DATABASE_URL=sqlite:///./data/btc_quant.db

# API
API_HOST=127.0.0.1
API_PORT=8700

# AI prediction (OpenAI Responses API by default)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
LLM_API_STYLE=responses
LLM_REASONING_EFFORT=medium
